#!/bin/bash
# Copies the current HEAD into the public repo's working copy, leaving out internal notes, and commits
# it there as one new commit on top of the public history. Nothing is pushed; push when you're ready.
#   scripts/export-public [destination]   (default: ../irori)
# A destination that doesn't exist yet becomes a fresh repo with a single commit.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=brand.env
source "$root/scripts/brand.env"
destination="${1:-$root/../irori}"
author_name="tofuchick3n"
author_email="247039655+tofuchick3n@users.noreply.github.com"
excluded=("docs/PLAN.md")
version="$(sed -n 's/^APP_VERSION="\(.*\)"/\1/p' "$root/scripts/brand.env")"

if [ -e "$destination" ] && [ ! -d "$destination/.git" ]; then
  echo "$destination exists but isn't a git repository." >&2
  exit 1
fi
if [ ! -d "$destination" ]; then
  mkdir -p "$destination"
  git -C "$destination" init -q -b main
fi
if [ -n "$(git -C "$destination" status --porcelain)" ]; then
  echo "$destination has uncommitted changes; commit or discard them first." >&2
  exit 1
fi

# Replace the tracked tree wholesale, so files deleted here are deleted there too.
git -C "$destination" ls-files -z | (cd "$destination" && xargs -0 rm -f)
git -C "$root" archive HEAD | tar -x -C "$destination"
for path in "${excluded[@]}"; do
  rm -f "$destination/$path"
done
git -C "$destination" add -A
if git -C "$destination" diff --cached --quiet; then
  echo "Nothing changed since the last export."
  exit 0
fi
GIT_AUTHOR_NAME="$author_name" GIT_AUTHOR_EMAIL="$author_email" \
GIT_COMMITTER_NAME="$author_name" GIT_COMMITTER_EMAIL="$author_email" \
  git -C "$destination" commit -q -m "$APP_NAME $version"
echo "Committed $APP_NAME $version in $destination ($(git -C "$destination" rev-list --count HEAD) commits)."
